rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'pyaephyoaung@skybridge-businesssolution.com'
             ];
    }

    // Each customer's subscription record, keyed by their auth uid.
    match /customers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Customers may create their own record at signup, but only in the
      // default "no plan yet" state — activating a paid plan is done by
      // an admin in admin.html (or the Firebase console) until a real
      // payment gateway is wired up.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.plan == null
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if false;
    }

    // A customer's submitted "please verify my payment" requests.
    // Admins confirm the payment out of band in admin.html, which then
    // activates the plan on the matching customers/{uid} document —
    // customers cannot edit these themselves once submitted.
    match /subscriptionRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if false;
    }

    // A user's own app preferences (e.g. their personal Finnhub API key for
    // the market dashboard) — fully owned and editable by that user only.
    match /userSettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
